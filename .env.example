# PostgreSQL connection string (Neon, Supabase, or local PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/velora?sslmode=disable"
# Optional direct/unpooled URL for Prisma migrations on Neon PgBouncer:
# DATABASE_URL_UNPOOLED="postgresql://user:password@host:5432/velora?sslmode=require"

# Auth.js v5 secret (generate with: openssl rand -base64 32)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Canonical site URL for SEO metadata, sitemap.xml, and robots.txt
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: Gemini API key for AI review analysis (falls back to built-in analyzer if omitted)
# GEMINI_API_KEY=""
